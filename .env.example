# Server & Vercel Configuration
PORT=5000

# SMTP Configuration for Nodemailer (Gmail / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
CONTACT_RECEIVER_EMAIL=your_email@gmail.com

# Analytics & Search Console (Frontend / Vite)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GSC_VERIFICATION_TOKEN=your_google_search_console_token
VITE_BING_VERIFICATION_TOKEN=your_bing_webmaster_token
